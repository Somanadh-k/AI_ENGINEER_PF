# ---------------------------------------------------------------------------
# SOMANADH.OS — Next.js configuration
# Copy to web/.env.local for local development, or set these in the hosting
# provider's environment settings.
# ---------------------------------------------------------------------------

# Server-only URL used by the Next.js server to reach FastAPI. This is NOT
# exposed to the browser. In production it should be a private/internal URL
# when possible. Do not append /api.
API_INTERNAL_URL=http://127.0.0.1:8000

# Public canonical site URL. Used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must equal PROXY_TOKEN on the API. Server-only.
API_PROXY_TOKEN=
