# ---------------------------------------------------------------------------
# SOMANADH.OS — API configuration
# Copy to .env at the repository root (or api/.env) and fill in real values.
# The API reads environment variables before this file.
# ---------------------------------------------------------------------------

# development | production
ENVIRONMENT=development
DEBUG=false

# The browser normally talks only to the Next.js proxy. This origin is used for
# direct API CORS during local development. No wildcard is allowed.
FRONTEND_ORIGIN=http://localhost:3000

# Local default. For production use:
# postgresql+psycopg://user:password@host:5432/somanadh
DATABASE_URL=sqlite+aiosqlite:///./data/somanadh.db

# Optional. The default is <repo>/content/portfolio.json. Only set this if you
# deploy the content file somewhere else; use an absolute path if in doubt.
# CONTENT_PATH=/absolute/path/to/content/portfolio.json

# --- AI provider (optional) -------------------------------------------------
# Leave both empty to run the deterministic, grounded local fallback. The UI
# labels fallback mode honestly. Live inference requires both values.
# Free models change often; this one was verified locally on 2026-10-25.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=SOMANADH.OS Portfolio
AI_TIMEOUT_SECONDS=60
# Reasoning-style models spend tokens before emitting visible text. Keep enough
# headroom that the answer is not truncated.
AI_MAX_OUTPUT_TOKENS=1600

# --- Admin ------------------------------------------------------------------
# Set EITHER a bcrypt hash (preferred) or a plain password for local dev.
# Generate a hash:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_EMAIL=skollavajjala@gmail.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_NAME=so_admin
COOKIE_SECURE=false
# Use a long random value in production. It salts rate-limit fingerprints.
SECRET_SALT=change-me-in-production

# --- Analytics --------------------------------------------------------------
ANALYTICS_RETENTION_DAYS=400
ACTIVE_WINDOW_SECONDS=60

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=6
MAX_CONTENT_BYTES=1500000
CONTACT_RATE_LIMIT=5
CHAT_RATE_LIMIT=20
EVENT_RATE_LIMIT=240

# Optional. Defaults are <api>/uploads and <api>/uploads/resume. In production
# point these at a persistent volume; use absolute paths.
# UPLOAD_DIR=/var/data/uploads
# RESUME_DIR=/var/data/uploads/resume
